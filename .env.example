# =============================================================================
#  Copy this file to `.env` and fill in the blanks.  NEVER commit `.env`.
#
#      cp .env.example .env
#
#  RULES
#   * Model names are deliberately EMPTY. This project ships no default model
#     name, because free-tier model names change every few months. Look up the
#     current ones yourself, then paste them here.
#   * Anything left empty is simply skipped (with a loud WARNING if it was the
#     only option for a stage).
# =============================================================================


# -----------------------------------------------------------------------------
# 1. GOOGLE GEMINI  (primary script writer)  --  FREE TIER
# -----------------------------------------------------------------------------
# Get a key:  https://aistudio.google.com/apikey
# Check which models are actually free right now (this changes often):
#   https://ai.google.dev/gemini-api/docs/pricing
#   https://ai.google.dev/gemini-api/docs/models
# Use the exact model ID string from that page, e.g. the current stable
# "<something>-flash" ID. Do not guess.
GEMINI_API_KEY=
GEMINI_MODEL=


# -----------------------------------------------------------------------------
# 2. GROQ  (FALLBACK script writer)  --  FREE TIER
# -----------------------------------------------------------------------------
# Get a key:  https://console.groq.com/keys
# List models: https://console.groq.com/docs/models
GROQ_API_KEY=
GROQ_MODEL=


# -----------------------------------------------------------------------------
# 3. POLLINATIONS  (primary image generator)  --  KEYLESS
# -----------------------------------------------------------------------------
# The legacy keyless endpoint still works but has tightened up:
#   * anonymous requests are throttled to roughly 1 request / 15 seconds
#   * generated images may carry a watermark; `nologo=true` is a hint, not a
#     guarantee, unless you register
# Leave POLLINATIONS_MODEL empty to let the server use its own default, or set
# a model id from https://image.pollinations.ai/models
POLLINATIONS_MODEL=

# Stay polite so you don't get HTTP 429. Lower it only if you know better.
POLLINATIONS_MIN_INTERVAL_SECONDS=15


# -----------------------------------------------------------------------------
# 4. CLOUDFLARE WORKERS AI  (FALLBACK image generator)  --  FREE TIER
# -----------------------------------------------------------------------------
# Needs both values or it is skipped entirely.
#   Account ID: Cloudflare dashboard -> Workers & Pages -> Account ID
#   API token : My Profile -> API Tokens -> "Workers AI" template
# Free allowance is 10,000 Neurons/day. Check burn rate at:
#   https://developers.cloudflare.com/workers-ai/platform/pricing/
CF_ACCOUNT_ID=
CF_API_TOKEN=
# The Workers AI model ID for the image model you want, e.g.
#   @cf/<vendor>/<model-id>
# Copy it exactly from https://developers.cloudflare.com/workers-ai/models/
CF_IMAGE_MODEL=


# -----------------------------------------------------------------------------
# 5. EDGE TTS  (voiceover)  --  FREE, NO KEY
# -----------------------------------------------------------------------------
# Unofficial reverse-engineered Microsoft Edge "Read Aloud" endpoint.
# No API key. Can break without notice; often blocked from datacenter IPs/VPNs.
# Voice list:  edge-tts --list-voices
EDGE_TTS_VOICE=en-US-JennyNeural
# Speaking rate / volume / pitch deltas, e.g. +0% , -10%
EDGE_TTS_RATE=+0%
EDGE_TTS_VOLUME=+0%
EDGE_TTS_PITCH=+0Hz


# -----------------------------------------------------------------------------
# 6. VIDEO / SLIDESHOW SETTINGS
# -----------------------------------------------------------------------------
SCENE_COUNT=5
MIN_TOTAL_SECONDS=30
MAX_TOTAL_SECONDS=45
VIDEO_WIDTH=1280
VIDEO_HEIGHT=720
VIDEO_FPS=30
KENBURNS_UPSCALE=2
# Seconds of extra motion after the narration ends, so the last word is never
# clipped. The clip length is driven by the TTS audio duration + this padding.
SCENE_TAIL_PAD_SECONDS=0.35


# -----------------------------------------------------------------------------
# 7. NETWORK / RELIABILITY
# -----------------------------------------------------------------------------
# Every external call is bounded by these. Connect, read.
HTTP_CONNECT_TIMEOUT_SECONDS=10
HTTP_READ_TIMEOUT_SECONDS=120
HTTP_MAX_RETRIES=3
TTS_MAX_ATTEMPTS=4

# INFO or DEBUG. Fallbacks always log at WARNING regardless.
LOG_LEVEL=INFO
